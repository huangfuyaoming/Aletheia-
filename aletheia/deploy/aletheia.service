[Unit]
Description=Aletheia image forensics web
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/autodl-tmp/sys_all/aletheia
Environment=APP_ENV=production
ExecStart=/root/miniconda3/bin/gunicorn --workers 1 --worker-class gthread --threads 4 --bind 0.0.0.0:6006 --timeout 300 --graceful-timeout 300 --access-logfile - --error-logfile - app:create_app()
Restart=on-failure
RestartSec=8
TimeoutStopSec=310
UMask=0077

[Install]
WantedBy=multi-user.target
